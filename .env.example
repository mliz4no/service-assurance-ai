# Core
PORT=8080
DATABASE_URL=postgresql://service_assurance:service_assurance@localhost:5432/service_assurance
SESSION_SECRET=replace-with-a-secure-random-secret
OPENAI_API_KEY=
NODE_ENV=development
LOG_LEVEL=info

# HTTP security. CORS_ALLOWED_ORIGINS is required when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Monitoring scheduler
MONITORING_SCHEDULER_ENABLED=false
MONITORING_INTERVAL_MS=60000
MONITORING_MODE=synthetic
MONITORING_RUN_IMMEDIATELY=false

# Public-service probes require verified ownership or explicit allowlisting by default.
PROBE_REQUIRE_OWNERSHIP_VERIFICATION=true
PROBE_HTTP_TIMEOUT_MS=5000
PROBE_TCP_TIMEOUT_MS=5000
PROBE_ICMP_TIMEOUT_MS=3000
PROBE_DNS_TIMEOUT_MS=5000
PROBE_TLS_TIMEOUT_MS=5000
PROBE_HTTP_MAX_REDIRECTS=0
PROBE_MAX_TARGETS_PER_RUN=100
PROBE_RATE_LIMIT_WINDOW_MS=60000
PROBE_RATE_LIMIT_MAX=10

# Event Monitor retention purge
EVENT_PURGE_ENABLED=false
EVENT_PURGE_INTERVAL_MS=86400000
EVENT_PURGE_RUN_IMMEDIATELY=false
EVENT_PURGE_RETENTION_DEFAULT_HOURS=24
EVENT_PURGE_RETENTION_INCIDENT_EVIDENCE_HOURS=2160
EVENT_PURGE_RETENTION_AUDIT_HOURS=8760
EVENT_PURGE_RETENTION_LEGAL_HOURS=61320
EVENT_PURGE_BATCH_SIZE=1000
EVENT_PURGE_MAX_BATCHES=50

# Nagios
NAGIOS_BASE_URL=
NAGIOS_USERNAME=
NAGIOS_PASSWORD=
NAGIOS_API_TOKEN=

# IP and external outage enrichment
IP_ENRICHMENT_PROVIDER=ipinfo
IPINFO_BASE_URL=https://ipinfo.io
IPINFO_TOKEN=
IP_ENRICHMENT_CACHE_ENABLED=false
IP_ENRICHMENT_CACHE_TTL_MS=86400000
POWER_OUTAGE_API_BASE_URL=
POWER_OUTAGE_API_TOKEN=

# Alert delivery
ALERT_EMAIL_API_URL=
ALERT_WEBHOOK_URL=
ALERT_DELIVERY_TOKEN=
ALERT_DELIVERY_TIMEOUT_MS=10000
ALERT_DELIVERY_MAX_ATTEMPTS=3
ALERT_DELIVERY_RETRY_DELAY_MS=250

# PagerDuty Events API v2
PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_SEVERITY_GATE=high
PAGERDUTY_DELIVERY_TIMEOUT_MS=10000
PAGERDUTY_DELIVERY_MAX_ATTEMPTS=3
PAGERDUTY_DELIVERY_RETRY_DELAY_MS=250

# InvoxAI machine-to-machine integration
INVOXAI_API_KEY=
INVOXAI_API_KEYS=
INVOXAI_API_SCOPES=integrations:create,integrations:read

# Salesforce
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# Avalara
AVALARA_BASE_URL=https://sandbox-rest.avatax.com/api/v2
AVALARA_ACCOUNT_ID=
AVALARA_LICENSE_KEY=
AVALARA_COMPANY_CODE=
